{
  "name": "ts-media-server",
  "version": "0.1.0",
  "description": "TypeScript/Node.js media server with indexing, thumbnails, face detection, and REST API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "media-server": "dist/index.js"
  },
  "scripts": {
    "dev": "pnpm run /^dev:/",
    "dev:server": "tsx watch src/index.ts serve",
    "dev:web": "pnpm --filter @ts-media-server/web dev",
    "build": "pnpm run build:web && tsup",
    "build:web": "pnpm --filter @ts-media-server/web build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:web": "pnpm --filter @ts-media-server/web test",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "media",
    "server",
    "photo",
    "video",
    "indexing",
    "thumbnails",
    "face-detection"
  ],
  "license": "ISC",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.4",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.0",
    "@fastify/websocket": "^11.2.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.8.0",
    "commander": "^14.0.3",
    "drizzle-orm": "^0.45.2",
    "exifr": "^7.1.3",
    "fastify": "^5.8.4",
    "fastify-plugin": "^5.1.0",
    "onnxruntime-node": "^1.24.3",
    "p-limit": "^7.3.0",
    "pino": "^10.3.1",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "better-sqlite3",
      "onnxruntime-node",
      "sharp"
    ]
  }
}
